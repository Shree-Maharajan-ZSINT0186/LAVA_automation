<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
  <configuration>
    <!-- Report theme --> <!-- Options: standard, dark -->
    <theme>Standard</theme>

    <!-- Document encoding -->
    <encoding>UTF-8</encoding>

    <!-- Protocol for script and stylesheets -->
    <protocol>https</protocol>

    <!-- Title of the document -->
    <documentTitle>Test Automation</documentTitle>

    <!-- Report name - displayed at top-nav -->
    <reportName>LAVA - Sanity Automation</reportName>

    <!-- Global date format override -->
    <dateFormat>yyyy-MM-dd</dateFormat>

    <!-- Global time format override -->
    <timeFormat>HH:mm:ss</timeFormat>

    <!-- Time zone -->
    <timeZone>Asia/Kolkata</timeZone>

    <!-- Show chart on load -->
    <chartVisibilityOnOpen>true</chartVisibilityOnOpen>

    <!-- Enable timeline chart -->
    <timelineEnabled>true</timelineEnabled>

    <!-- Custom JavaScript -->
    <scripts>
      <![CDATA[
        $(document).ready(function() {
            console.log("Extent Report Ready");
        });
      ]]>
    </scripts>

    <!-- Custom Styles -->
    <styles>
      <![CDATA[
        .test-info {
          color: #00e676 !important;
          font-weight: bold;
        }
        .nav-wrapper {
          background-color: #1e1e2f !important;
        }
      ]]>
    </styles>
  </configuration>
</extentreports>
